# Copy these keys into your project's LOCAL .env (must be gitignored). Never commit real values.
# Token: the Bot User OAuth Token (starts with xoxb-), from your Slack app's "OAuth & Permissions" page.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Required for watch: comma-separated Slack user ids allowed to steer the session (yours, e.g. U0123).
# watch refuses to start while this is empty; messages from anyone else are ignored.
SLACK_ALLOWED_USERS=
# Optional (blank = default)
SLACK_POLL_SECONDS=20
SLACK_MAX_BACKLOG_SECONDS=3600
SLACK_THREAD_TTL_SECONDS=86400
SLACK_THREAD_SCAN_SECONDS=60
# SLACK_STATE_DIR=
# SLACK_API_BASE=https://slack.com/api
